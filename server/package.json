{
  "name": "naatal-server",
  "version": "1.0.0",
  "description": "Backend API pour NAATAL Production",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "psql -d naatal_db -f ../database/init.sql -f ../database/offres.sql -f ../database/leads.sql -f ../database/portfolio.sql",
    "db:migrate": "node scripts/migrate.js",
    "db:sync": "node scripts/sync-from-production.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
